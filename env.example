# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY

# OBRIGATORIO para a tela de Usuarios (convidar/gerenciar tecnicos).
# Pegue em: Supabase > Project Settings > API > service_role key.
# NUNCA exponha essa chave no navegador (por isso nao tem prefixo NEXT_PUBLIC_).
# Na Vercel: Project Settings > Environment Variables > adicionar aqui.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: URL fixa para o link do WhatsApp no chamado publico
NEXT_PUBLIC_PANEL_URL=https://app.meusistema.com/painel

# Opcional: usada no link de convite enviado ao tecnico. Se nao definida,
# o sistema usa automaticamente o dominio de onde a requisicao veio.
NEXT_PUBLIC_SITE_URL=https://rd-sistema-os.vercel.app
